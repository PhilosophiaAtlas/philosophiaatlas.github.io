---
import Layout from '../../../.vendor/wiki-ui/src/WikiLayout.astro';
import {getWiki} from '../../lib/wiki.mjs';
const wiki=await getWiki();
const byId=new Map(wiki.articles.map(a=>[a.id,a]));
const wanted=new Map();
for(const d of wiki.diagnostics){if(d.code!=='W001')continue;const refs=wanted.get(d.target)??new Set();refs.add(d.article);wanted.set(d.target,refs);}
const missing=[...wanted].sort((a,b)=>b[1].size-a[1].size||a[0].localeCompare(b[0]));
---
<Layout title="Trang đặc biệt"><h1>Trang đặc biệt</h1>
<h2>Công cụ cá nhân</h2><p><a href="/library/">Thư viện cá nhân: bài đã lưu, theo dõi và lịch sử đọc</a>.</p>
<p><a href="/research/">Bàn nghiên cứu: ghi chú, trích đoạn và liên kết cá nhân</a>.</p>
<h2>Thống kê</h2><p>{wiki.articles.length} bài viết, {Object.keys(wiki.categories).length} thể loại, {missing.length} mục từ chưa tồn tại ({wiki.diagnostics.filter(d=>d.code==='W001').length} lượt cảnh báo liên kết).</p>
<h2>Chuyển hướng</h2><p>{Object.keys(wiki.redirects).length} địa chỉ thay thế.</p><ul>{Object.entries(wiki.redirects).map(([alias,id])=><li><a href={'/wiki/'+alias+'/'} target="_self">{alias}</a> → <a href={'/wiki/'+id+'/'}>{byId.get(id)?.title??id}</a></li>)}</ul>
<h2>Trang định hướng</h2><ul>{wiki.articles.filter(a=>a.kind==='disambiguation').map(a=><li><a href={'/wiki/'+a.id+'/'}>{a.title}</a></li>)}</ul>
<h2>Bài chưa tồn tại</h2><ul>{missing.map(([target,refs])=><li><span class="missing-link">{target}</span> ({refs.size} bài nhắc đến)<ul>{[...refs].map(id=><li><a href={'/wiki/'+id+'/'}>{byId.get(id)?.title??id}</a></li>)}</ul></li>)}</ul>
<h2>Chú thích chưa định nghĩa</h2>{wiki.diagnostics.some(d=>d.code==='W002')?<ul>{wiki.diagnostics.filter(d=>d.code==='W002').map(d=><li>{d.target} · <a href={'/wiki/'+d.article+'/'}>{byId.get(d.article)?.title??d.article}</a></li>)}</ul>:<p>Không có cảnh báo.</p>}
<h2>Bài không có liên kết đến</h2><ul>{wiki.articles.filter(a=>!wiki.backlinks[a.id]?.length).map(a=><li><a href={'/wiki/'+a.id+'/'}>{a.title}</a></li>)}</ul>
</Layout>
