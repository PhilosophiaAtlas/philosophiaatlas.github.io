---
import Layout from '../../../.vendor/wiki-ui/src/WikiLayout.astro';
import {getWiki} from '../../lib/wiki.mjs';
const {articles}=await getWiki();
---
<Layout title="Tất cả bài viết"><h1>Tất cả bài viết</h1><ul>{articles.map(a=><li><a href={'/wiki/'+a.id+'/'}>{a.title}</a> <span class="subtitle">{a.originalTitle}</span></li>)}</ul></Layout>
