---
import Layout from '../../../.vendor/wiki-ui/src/WikiLayout.astro';
import {getWiki} from '../../lib/wiki.mjs';
import {categoryId} from '../../lib/categories.mjs';
export async function getStaticPaths(){const wiki=await getWiki();const byId=new Map(wiki.articles.map(a=>[a.id,a]));return Object.entries(wiki.categories).map(([name,ids])=>({params:{id:categoryId(name)},props:{name,articles:ids.map(id=>byId.get(id)).filter(Boolean)}}));}
const {name,articles}=Astro.props;
---
<Layout title={'Thể loại: '+name}><p><a href="/category/">Tất cả thể loại</a></p><h1>Thể loại: {name}</h1><p>{articles.length} bài viết.</p><ul class="article-list">{articles.map(a=><li><a href={'/wiki/'+a.id+'/'}>{a.title}</a><span class="subtitle">{a.originalTitle}</span></li>)}</ul></Layout>
