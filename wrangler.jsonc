{
  "name": "philosophia",
  "main": "worker/auth.mjs",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "120631",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
