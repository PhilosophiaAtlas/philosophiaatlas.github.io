{
  "name": "philosophiaatlas-site",
  "version": "0.1.0-alpha.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "node --test .vendor/wiki-core/test/compiler.test.mjs tests/library.test.mjs tests/history.test.mjs tests/research.test.mjs && node .vendor/research-toolkit/scripts/audit.mjs .vendor/knowledge-base/articles",
    "test:browser": "node --test tests/preview.browser.test.mjs tests/auth.browser.test.mjs tests/history.browser.test.mjs tests/research.browser.test.mjs",
    "test:auth": "node --test tests/auth.test.mjs",
    "build:cloudflare": "node scripts/sync.mjs && npm test && npm run test:auth && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "astro": "5.13.2",
    "markdown-it": "14.1.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "pagefind": "1.3.0",
    "playwright": "1.55.0"
  }
}
