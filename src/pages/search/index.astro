---
import Layout from '../../../.vendor/wiki-ui/src/WikiLayout.astro';
import {getWiki} from '../../lib/wiki.mjs';
const {articles}=await getWiki();
---
<Layout title="Tìm kiếm">
<h1>Tìm kiếm</h1>
<form class="search-form" id="search-form" action="/search/"><label class="sr-only" for="query">Từ khóa</label><input type="search" id="query" name="q" placeholder="Tiếng Việt hoặc tiếng Anh"/><button type="submit">Tìm</button></form>
<p class="subtitle">Tìm theo tiêu đề, tên gốc và tên thay thế. Chưa hỗ trợ tìm toàn văn.</p>
<p id="result-count" role="status">{articles.length} mục từ</p>
<noscript><p>Bật JavaScript để lọc kết quả, hoặc duyệt danh sách dưới đây.</p></noscript>
<ul class="article-list search-results" id="results">{articles.map(a=><li data-search={[a.id,a.title,a.originalTitle??'',...a.aliases].join(' ')}><a href={'/wiki/'+a.id+'/'}>{a.title}</a><span class="subtitle">{a.originalTitle}</span></li>)}</ul>
<script is:inline>
const q=document.getElementById('query'),form=document.getElementById('search-form'),items=[...document.querySelectorAll('#results li')],count=document.getElementById('result-count');
const norm=s=>s.normalize('NFD').replace(/\p{M}/gu,'').toLowerCase().replace(/đ/g,'d');
q.value=new URLSearchParams(location.search).get('q')??'';
const index=items.map(li=>[li,norm(li.dataset.search)]);
function filter(){const terms=norm(q.value).trim().split(/\s+/).filter(Boolean);let n=0;for(const [li,value] of index){li.hidden=!terms.every(t=>value.includes(t));if(!li.hidden)n++;}count.textContent=n+' kết quả';}
form.addEventListener('submit',e=>{e.preventDefault();const url=new URL(location.href);if(q.value.trim())url.searchParams.set('q',q.value.trim());else url.searchParams.delete('q');history.replaceState(null,'',url);filter();});q.addEventListener('input',filter);filter();
</script>
</Layout>
